      "provider": {
        "id": "demucs",
        "model": "htdemucs",
        "device": "cpu"
      },
      "config": {},
      "autoContinue": true
    },
    {
      "id": "recognize",
      "type": "youdub.transcribe",
      "typeVersion": "1.0.0",
      "provider": {
        "id": "whisper",
        "model": "tiny",
        "device": "cpu"
      },
      "config": {
        "sourceLanguage": "en"
      },
      "autoContinue": true
    },
    {
      "id": "translate",
      "type": "youdub.translate",
      "typeVersion": "1.0.0",
      "provider": {
        "id": "llm.youdub-ark",
        "model": "doubao-seed-evolving",
        "device": "remote"
      },
      "config": {
        "sourceLanguage": "en",
        "targetLanguage": "zh",
        "maxCompletionTokens": 65535
      },
      "autoContinue": true
    },
    {
      "id": "reference",
      "type": "youdub.reference",
      "typeVersion": "1.0.0",
      "provider": {
        "id": "youdub.media"
      },
      "config": {},
