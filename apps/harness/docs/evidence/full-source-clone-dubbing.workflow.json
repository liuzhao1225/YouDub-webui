        "id": "voxcpm",
        "model": "VoxCPM2",
        "device": "cpu"
      },
      "config": {
        "targetLanguage": "zh",
        "voice": {
          "mode": "source_clone"
        }
      },
      "autoContinue": true
    },
    {
      "id": "mix",
      "type": "youdub.mix",
      "typeVersion": "1.0.0",
      "provider": {
        "id": "youdub.media"
      },
