{
  "name": "@youdub/harness-subtitles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouDub 视频处理、字幕与配音工作流",
  "license": "Apache-2.0",
  "main": "dist/host.mjs",
  "exports": {
    ".": "./dist/host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node launch.mjs",
    "desktop": "node desktop.mjs",
    "pretest": "node -e \"require('electron')\" && node build-framework.mjs --verify-only",
    "test": "node --import ./test/source-framework.mjs --test test/*.test.mjs",
    "check:composition": "node check-composition.mjs",
    "check:framework": "node framework-source.mjs",
    "build:desktop": "node build-desktop.mjs",
    "build:framework": "node build-framework.mjs",
    "build:product": "node build.mjs && node build-desktop.mjs",
    "dev": "node desktop.mjs",
    "check:locales": "node check-locales.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "3.49.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.10",
    "lightningcss": "1.33.0",
    "playwright": "1.61.1",
    "pnpm": "11.28.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2"
  }
}
