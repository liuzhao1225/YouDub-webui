# Copy values into .env for application runtime.
# Keep env.txt for local editing if you do not want to open .env directly.
WORKFOLDER=./workfolder
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
YOUDUB_AUTH_PASSWORD_HASH=
YOUDUB_AUTH_SESSION_TTL_SECONDS=604800
YOUDUB_AUTH_COOKIE_SECURE=false
YOUDUB_AUTH_COOKIE_SAMESITE=strict
DEVICE=cuda
DEMUCS_DEVICE=
DEMUCS_CHUNK_SECONDS=600
WHISPER_DEVICE=
RELEASE_GPU_MEMORY_AFTER_STAGE=true
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_UPLOAD_MAX_BYTES=4294967296
LOCAL_SUBTITLE_MAX_BYTES=20971520
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_CONCURRENCY=50
# Optional Atlas Cloud aliases for the OpenAI-compatible translator.
# Used when OPENAI_API_KEY is empty.
ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1
ATLASCLOUD_MODEL=deepseek-ai/deepseek-v4-pro
YTDLP_PROXY_PORT=
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
VOXCPM_MODEL=OpenBMB/VoxCPM2
VOXCPM_MODEL_DIR=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
