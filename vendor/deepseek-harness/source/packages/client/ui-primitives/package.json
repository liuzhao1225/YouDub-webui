{
  "name": "@deepseek-ai/dsh-client-ui-primitives",
  "description": "Shared React controls used by YouDub, styled through Harness tokens",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-primitives"
  },
  "type": "module",
  "main": "lib/index.js",
