{
  "name": "@deepseek-ai/dsh-root",
  "version": "0.2.1-rc.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:artifacts": "tsx scripts/build.ts --scope artifacts",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "test": "vitest run",
    "test:gui": "vitest run packages/client packages/host"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "execa": "^10.0.1",
    "zod": "^4.4.3",
    "fast-check": "^4.9.0",
    "js-yaml": "^4.3.2",
    "jsdom": "29.1.1",
    "lightningcss": "^1.33.0",
    "pnpm": "11.28.5",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
