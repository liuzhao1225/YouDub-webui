{
  "name": "youdub-webui-fullstack",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/host",
    "packages/sdk",
    "packages/builtin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build:desktop": "npm run build:youdub",
    "test:downloads": "node --test scripts/download-releases.test.mjs",
    "dev:api": "node --import tsx apps/host/src/main.ts",
    "start": "npm --prefix apps/harness run desktop",
    "plugins": "node --import tsx apps/host/src/plugins.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "build:plugins": "npm --prefix apps/web run plugins:build",
    "test:backend": "node scripts/test-backend.mjs",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build",
    "start:legacy": "node --import tsx apps/host/src/main.ts",
    "build:youdub": "npm --prefix apps/harness run build:product",
    "check:harness": "npm --prefix apps/harness run check:composition && npm --prefix apps/harness run check:upstream",
    "build:framework": "npm --prefix apps/harness run build:framework",
    "dev": "npm --prefix apps/harness run desktop"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-ai": "0.82.1",
    "ajv": "8.17.1",
    "busboy": "1.6.0",
    "cordis": "4.0.0-rc.10",
    "dotenv": "16.6.1",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
