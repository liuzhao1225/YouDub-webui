{
  "format": "youdub.workflow",
  "formatVersion": 1,
  "id": "example.source-clone-dubbing",
  "title": "视频配音 · 原声克隆",
  "nodes": [
    {
      "id": "prepare",
      "type": "youdub.prepare",
      "typeVersion": "1.0.0",
      "provider": { "id": "youdub.media" },
      "config": {},
      "autoContinue": true
    },
    {
      "id": "separate",
      "type": "youdub.separate",
      "typeVersion": "1.0.0",
      "provider": { "id": "demucs", "model": "htdemucs", "device": "cpu" },
      "config": {},
      "autoContinue": true
    },
    {
      "id": "recognize",
      "type": "youdub.transcribe",
      "typeVersion": "1.0.0",
      "provider": { "id": "whisper", "model": "tiny", "device": "cpu" },
      "config": { "sourceLanguage": "en" },
      "autoContinue": true
    },
    {
      "id": "translate",
      "type": "youdub.translate",
      "typeVersion": "1.0.0",
      "provider": { "id": "openai" },
      "config": {
        "sourceLanguage": "en",
        "targetLanguage": "zh"
      },
      "autoContinue": true
    },
    {
      "id": "reference",
      "type": "youdub.reference",
      "typeVersion": "1.0.0",
      "provider": { "id": "youdub.media" },
      "config": {},
      "autoContinue": true
    },
    {
      "id": "synthesize",
      "type": "youdub.synthesize",
      "typeVersion": "1.0.0",
      "provider": { "id": "voxcpm", "model": "VoxCPM2", "device": "cpu" },
      "config": { "targetLanguage": "zh", "voice": { "mode": "source_clone" } },
      "autoContinue": true
    },
    {
      "id": "mix",
      "type": "youdub.mix",
      "typeVersion": "1.0.0",
      "provider": { "id": "youdub.media" },
      "config": { "keepBackground": true },
      "autoContinue": true
    },
    {
      "id": "export",
      "type": "youdub.export",
      "typeVersion": "1.0.0",
      "provider": { "id": "youdub.media" },
      "config": { "sourceLanguage": "en", "targetLanguage": "zh", "renderSubtitles": false },
      "autoContinue": true
    }
  ],
  "edges": [
    {
      "id": "input-prepare",
      "source": { "nodeId": "$inputs", "portId": "video" },
      "target": { "nodeId": "prepare", "portId": "video" }
    },
    {
      "id": "prepare-separate",
      "source": { "nodeId": "prepare", "portId": "sourceAudio" },
      "target": { "nodeId": "separate", "portId": "sourceAudio" }
    },
    {
      "id": "separate-recognize",
      "source": { "nodeId": "separate", "portId": "vocals" },
      "target": { "nodeId": "recognize", "portId": "audio" }
    },
    {
      "id": "prepare-recognize",
      "source": { "nodeId": "prepare", "portId": "mediaInfo" },
      "target": { "nodeId": "recognize", "portId": "mediaInfo" }
    },
    {
      "id": "recognize-translate",
      "source": { "nodeId": "recognize", "portId": "transcript" },
      "target": { "nodeId": "translate", "portId": "transcript" }
    },
    {
      "id": "recognize-reference",
      "source": { "nodeId": "recognize", "portId": "transcript" },
      "target": { "nodeId": "reference", "portId": "transcript" }
    },
    {
      "id": "separate-reference",
      "source": { "nodeId": "separate", "portId": "vocals" },
      "target": { "nodeId": "reference", "portId": "audio" }
    },
    {
      "id": "recognize-synthesize",
      "source": { "nodeId": "recognize", "portId": "transcript" },
      "target": { "nodeId": "synthesize", "portId": "transcript" }
    },
    {
      "id": "translate-synthesize",
      "source": { "nodeId": "translate", "portId": "translation" },
      "target": { "nodeId": "synthesize", "portId": "translation" }
    },
    {
      "id": "reference-synthesize",
      "source": { "nodeId": "reference", "portId": "references" },
      "target": { "nodeId": "synthesize", "portId": "references" }
    },
    {
      "id": "recognize-mix",
      "source": { "nodeId": "recognize", "portId": "transcript" },
      "target": { "nodeId": "mix", "portId": "transcript" }
    },
    {
      "id": "synthesize-mix",
      "source": { "nodeId": "synthesize", "portId": "speechAudio" },
      "target": { "nodeId": "mix", "portId": "speechAudio" }
    },
    {
      "id": "prepare-mix",
      "source": { "nodeId": "prepare", "portId": "mediaInfo" },
      "target": { "nodeId": "mix", "portId": "mediaInfo" }
    },
    {
      "id": "separate-mix",
      "source": { "nodeId": "separate", "portId": "background" },
      "target": { "nodeId": "mix", "portId": "background" }
    },
    {
      "id": "input-export",
      "source": { "nodeId": "$inputs", "portId": "video" },
      "target": { "nodeId": "export", "portId": "video" }
    },
    {
      "id": "prepare-export",
      "source": { "nodeId": "prepare", "portId": "mediaInfo" },
      "target": { "nodeId": "export", "portId": "mediaInfo" }
    },
    {
      "id": "recognize-export",
      "source": { "nodeId": "recognize", "portId": "transcript" },
      "target": { "nodeId": "export", "portId": "transcript" }
    },
    {
      "id": "translate-export",
      "source": { "nodeId": "translate", "portId": "translation" },
      "target": { "nodeId": "export", "portId": "translation" }
    },
    {
      "id": "mix-export-audio",
      "source": { "nodeId": "mix", "portId": "finalAudio" },
      "target": { "nodeId": "export", "portId": "finalAudio" }
    },
    {
      "id": "mix-export-timeline",
      "source": { "nodeId": "mix", "portId": "dubbedTimeline" },
      "target": { "nodeId": "export", "portId": "dubbedTimeline" }
    }
  ],
  "inputs": [
    {
      "id": "video",
      "label": "视频",
      "required": true,
      "kind": "artifact",
      "schemaId": "file/v1",
      "acceptedMimeTypes": ["video/*"],
      "maxBytes": 4294967296
    }
  ],
  "outputs": [
    {
      "id": "video",
      "label": "配音视频",
      "kind": "artifact",
      "schemaId": "video/mp4/v1",
      "required": true,
      "source": { "nodeId": "export", "portId": "video" }
    },
    {
      "id": "audio",
      "label": "配音音频",
      "kind": "artifact",
      "schemaId": "audio/wav/v1",
      "required": true,
      "source": { "nodeId": "export", "portId": "audio" }
    }
  ],
  "presentation": {
    "positions": {
      "$inputs": { "x": 0, "y": 120 },
      "prepare": { "x": 320, "y": 120 },
      "separate": { "x": 640, "y": 120 },
      "recognize": { "x": 960, "y": 120 },
      "translate": { "x": 1280, "y": 0 },
      "reference": { "x": 1280, "y": 340 },
      "synthesize": { "x": 1600, "y": 120 },
      "mix": { "x": 1920, "y": 120 },
      "export": { "x": 2240, "y": 120 },
      "$outputs": { "x": 2560, "y": 120 }
    },
    "viewport": { "x": 40, "y": 40, "zoom": 0.5 }
  }
}
